# Copy to .env (or set these in your host's dashboard). Never commit real values.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=www.vaishnavcreations.com,vaishnavcreations.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.vaishnavcreations.com,https://vaishnavcreations.com
SITE_URL=https://www.vaishnavcreations.com
DATABASE_URL=postgres://user:password@host:5432/dbname
MEDIA_ROOT=/var/data/media

# Optional: email new enquiries (e.g. Gmail app password, Zoho, Brevo SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=app-password
DEFAULT_FROM_EMAIL=website@vaishnavcreations.com
